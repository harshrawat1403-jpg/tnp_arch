# Public canonical URL used for absolute links when configured.
# Leave unset for local development; use http://localhost:3000 if needed.
NEXT_PUBLIC_APP_URL=

# Supabase browser-safe connection details. Use the local stack values from
# `supabase status` during local development. Never place a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
